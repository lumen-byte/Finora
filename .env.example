PROJECT_NAME="Finora API"

# PostgreSQL Connection
POSTGRES_SERVER=db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=finora
DATABASE_URL=postgresql://postgres:postgres@db:5432/finora

# Authentication (Generate a secure 32-byte hex string)
# Command: openssl rand -hex 32
SECRET_KEY=your_super_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS for Production
# Must be a JSON array of strings
CORS_ORIGINS=["https://finora.vercel.app", "http://localhost:5173"]

# Groq API for Copilot
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.6-27b
